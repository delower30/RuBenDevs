# Environment Configuration
NODE_ENV=development
PORT=5000

# SQLite Database Location
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secret_dhaka_tesla_key_never_share_in_production_90fps
JWT_EXPIRES_IN=7d

# Pricing Parameters (Integer Poysha: 1 BDT = 100 Poysha)
BASE_FARE_POYSHA=3000          # ৳30.00 base fare
RATE_PER_KM_POYSHA=1500        # ৳15.00 / km
POOL_DISCOUNT_PERCENT=25       # 25% discount for matched pool
VEHICLE_MAX_CAPACITY=3         # Bullet 3-seat limit
